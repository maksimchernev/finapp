{
  "name": "finance-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Finance Tracker with OAuth and Tesseract OCR",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,env --exec tsx src/index.ts",
    "build": "tsc",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "token": "tsx test.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "node --env-file=.env ./node_modules/prisma/build/index.js studio --schema prisma/schema.prisma",
    "studio": "node --env-file=.env ./node_modules/prisma/build/index.js studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "keywords": [
    "finance",
    "api",
    "oauth",
    "ocr"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-yandex": "^0.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "nodemon": "^3.1.14",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
