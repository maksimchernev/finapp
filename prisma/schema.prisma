// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  provider  String   // 'google' or 'yandex'
  providerId String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aiTestAccess Boolean @default(false)

  transactions Transaction[]
  preferences  UserPreferences?
  banks        Bank[]
  categories   Category[]
  creditCards  CreditCard[]
  pushSubscriptions PushSubscription[]
  aiUsage AiUsageDaily[]

  @@map("users")
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  amountMinor Int
  currency   String   @default("RUB")
  date       DateTime
  merchant   String
  categoryId String?
  bankId     String?
  confidence Float?   // OCR confidence score (0-100)
  sourceType String   @default("screenshot") // screenshot, manual, statement
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  bank     Bank?     @relation(fields: [bankId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([date])
  @@index([categoryId])
  @@index([bankId])
  @@map("transactions")
}

model Bank {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  keywords       String[] @default([])
  lastImportedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("banks")
}

model Category {
  id          String   @id @default(cuid())
  userId      String?
  name        String   @unique
  nameRu      String   // Russian name for UI
  icon        String   // Tabler icon name (e.g., 'shopping-cart')
  color       String   // Hex color code
  bgColor     String   // Background color for UI
  type        String   // 'expense' or 'income'
  keywords    String[] // Keywords for auto-categorization
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("categories")
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  defaultCurrency String   @default("EUR")
  budgetLimits    Json?    // { "groceries": 500, "transport": 200, ... }
  aiRecognitionConsent Boolean?
  recognitionMethod String @default("tesseract")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model AiUsageDaily {
  id String @id @default(cuid())
  userId String
  provider String
  day DateTime
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  totalTokens Int @default(0)
  inFlight Boolean @default(false)
  reservationExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, day])
  @@index([userId, day])
  @@map("ai_usage_daily")
}

model CreditCard {
  id                       String   @id @default(cuid())
  userId                   String
  name                     String
  currency                 String   @default("RUB")
  gracePeriodEndDate       DateTime? @db.Date
  gracePaid                Boolean  @default(false)
  minPaymentAssignmentDate DateTime? @db.Date
  assignmentProcessedDate  DateTime? @db.Date
  minPaymentDueDate        DateTime? @db.Date
  minPaymentAmountMinor    Int?
  minPaymentPaid           Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances       CreditCardBalance[]
  graceHistory   CreditCardGracePeriod[]
  paymentHistory CreditCardMinimumPayment[]
  deliveries     CreditCardPushDelivery[]

  @@index([userId])
  @@map("credit_cards")
}

model CreditCardBalance {
  id          String   @id @default(cuid())
  cardId      String
  date        DateTime @db.Date
  amountMinor Int
  createdAt   DateTime @default(now())

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, date])
  @@map("credit_card_balances")
}

model CreditCardMinimumPayment {
  id          String   @id @default(cuid())
  cardId      String
  dueDate     DateTime @db.Date
  amountMinor Int
  paid        Boolean
  archivedAt  DateTime @default(now())

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("credit_card_minimum_payments")
}

model CreditCardGracePeriod {
  id         String   @id @default(cuid())
  cardId     String
  endDate    DateTime @db.Date
  paid       Boolean
  archivedAt DateTime @default(now())

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("credit_card_grace_periods")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries CreditCardPushDelivery[]

  @@index([userId])
  @@map("push_subscriptions")
}

model CreditCardPushDelivery {
  id             String   @id @default(cuid())
  cardId         String
  subscriptionId String
  eventKey       String
  sentAt         DateTime @default(now())

  card         CreditCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventKey])
  @@map("credit_card_push_deliveries")
}
